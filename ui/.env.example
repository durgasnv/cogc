# Admin login password (you choose this — share only with the event host/controller)
ADMIN_PASSWORD=change-me-before-deploying

# Secret used to sign session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Vercel KV — auto-filled by Vercel when you connect a KV store to this project
# (Storage tab in your Vercel dashboard -> Create Database -> KV -> Connect to Project)
KV_REST_API_URL=
KV_REST_API_TOKEN=
